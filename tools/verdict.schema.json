{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Critic verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["round", "bar", "order_ab", "order_ba", "result", "biggest_gap", "acceptance", "machine_check", "artifacts", "next"],
  "properties": {
    "issue": {"type": "integer", "minimum": 1, "description": "Issue number; may instead be passed with --issue"},
    "round": {"type": "integer", "minimum": 1, "maximum": 5},
    "bar": {
      "type": "object", "additionalProperties": false, "required": ["name", "pin"],
      "properties": {"name": {"type": "string", "minLength": 1}, "pin": {"type": "string", "minLength": 1}}
    },
    "order_ab": {"enum": ["candidate", "bar"], "description": "Winner when shown as A=candidate, B=bar"},
    "order_ba": {"enum": ["candidate", "bar"], "description": "Winner when shown as A=bar, B=candidate"},
    "result": {"enum": ["WIN", "LOSS", "SPLIT"]},
    "biggest_gap": {"type": "string", "minLength": 1, "description": "One sentence, concrete, fixable"},
    "acceptance": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["status", "evidence"],
        "properties": {
          "status": {"enum": ["PASS", "FAIL"]},
          "score": {"type": "integer", "minimum": 1, "maximum": 5},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "machine_check": {
      "type": "object", "additionalProperties": false, "required": ["status", "link"],
      "properties": {"status": {"enum": ["PASS", "FAIL"]}, "link": {"type": "string", "minLength": 1}}
    },
    "other_notes": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "next": {"enum": ["builder fixes the biggest gap", "ready to merge", "needs-human"]}
  },
  "allOf": [
    {"if": {"properties": {"result": {"const": "WIN"}}},
     "then": {"properties": {"order_ab": {"const": "candidate"}, "order_ba": {"const": "candidate"}, "next": {"const": "ready to merge"}}}},
    {"if": {"properties": {"result": {"enum": ["LOSS", "SPLIT"]}}},
     "then": {"properties": {"next": {"enum": ["builder fixes the biggest gap", "needs-human"]}}}}
  ]
}
