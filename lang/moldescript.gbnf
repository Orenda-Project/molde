tparts ::= tpart (sp tpart)*
tpart ::= string | expr
icon-stmt ::= "icon" sp primary (sp mod)*
image-stmt ::= "image" sp expr (sp mod)*
space-stmt ::= "space" (sp number)?
divider-stmt ::= "divider"
button-stmt ::= "button" sp tparts (sp mod)*
field-stmt ::= "field" sp path (sp string)? (sp mod)*
toggle-stmt ::= "toggle" sp path (sp window)? (sp "where" sp expr)? (sp mod)*
choice-stmt ::= "choice" sp path (sp mod)*
slider-stmt ::= "slider" sp path sp range-lit (sp mod)*
draw-stmt ::= "draw" (sp number "," sp number)? (sp mod)*
plot-stmt ::= "plot" sp range "," sp range (sp mod)*
tick-stmt ::= ("tick" | "ytick") sp expr "," sp tparts
shape-stmt ::= ("rect" sp e4 | "line" sp e4 | "circle" sp (e3 | expr) | "arc" sp (e5 | e3) | "path" sp string | "label" sp expr "," sp expr "," sp tparts) (sp mod)*
poly-stmt ::= "poly" (sp mod)*
pt-stmt ::= "pt" sp expr "," sp expr
e3 ::= expr "," sp expr "," sp expr
e4 ::= e3 "," sp expr
e5 ::= e4 "," sp expr
mod ::= "big" | "head" | "faint" | "axes" | "gridlines" | "middle" | "full" | "ratio" sp expr | size | "bold" | "card" | "grow" | "color" sp expr | "fill" sp expr | "stroke" sp expr | "thick" sp expr | "opacity" sp expr | "width" sp expr | "height" sp expr | "radius" sp expr | "pad" sp number | "gap" sp number | "span" sp number | "align" sp align | "alt" sp (string | expr) | "bar" | "tap" sp actions | "swipe" sp actions
size ::= "tiny" | "small" | "large" | "huge"
align ::= "start" | "center" | "end"
actions ::= action (sp "then" sp action)*
action ::= "add" sp ident (sp assign ("," sp assign)*)? | "set" sp path sp "=" sp expr | "remove" sp expr | "set" sp "all" sp path sp "=" sp expr (sp "where" sp expr)? | "remove" sp "all" sp query | "toggle" sp path (sp window)? (sp "where" sp expr)? | "edit" sp expr | "save" sp ident | "go" sp ident | "notify" sp tparts | "remind" sp string sp "in" sp expr | "after" sp dur sp action | ident
assign ::= ident sp "=" sp expr
expr ::= and-expr (sp "or" sp and-expr)*
and-expr ::= not-expr (sp "and" sp not-expr)*
not-expr ::= "not" sp not-expr | cmp-expr
cmp-expr ::= sum-expr (sp cmp-op sp sum-expr)?
cmp-op ::= "=" | "!=" | "<=" | ">=" | "<" | ">"
sum-expr ::= prod-expr (sp add-op sp prod-expr)*
add-op ::= "+" | "-"
prod-expr ::= unary (sp mul-op sp unary)*
mul-op ::= "*" | "/" | "%"
unary ::= "-" unary | primary
primary ::= "yes" | "no" | "today" | "now" | "index" | "pi" | color | func ("." ident)* | "(" expr ")" | datelit | number | string | time | dur | path | cword
color ::= "accent" | "ink" | "muted" | "soft" | "good" | "warn" | "bad" | "bg" | "surface" | "edge" | "red" | "orange" | "yellow" | "green" | "teal" | "blue" | "purple" | "pink" | "grey" | "black" | "white"
path ::= ("it" | ident) ("." ident)*
func ::= agg query ")" | fold source "," sp expr ")" | "if(" expr "," sp expr "," sp expr ")" | "clamp(" expr "," sp expr "," sp expr ")" | fn1 expr ")" | fn2 expr "," sp expr ")" | ("min(" | "max(") expr "," sp expr ")" | "due(" query "," sp expr ")" | "nth(" query "," sp expr ")" | "random(" query ")" | "join(" tpart ("," sp tpart)* ")" | ident "(" expr ("," sp expr)* ")"
agg ::= "count(" | "sum(" | "avg(" | "min(" | "max(" | "last(" | "first(" | "streak(" | "best(" | "since(" | "gap("
fold ::= "count(" | "sum(" | "min(" | "max("
fn1 ::= "round(" | "floor(" | "abs(" | "len(" | "weekday(" | "monthday(" | "monthdays(" | "dayname(" | "monthname(" | "hour(" | "minute(" | "second(" | "month(" | "year(" | "sin(" | "cos(" | "hue(" | "random(" | "words("
fn2 ::= "has(" | "addmonths(" | "pow(" | "plural(" | "fixed("
window ::= "today" | "yesterday" | "all" | "prev" sp period | "last" sp number sp periods | "on" sp primary | period (sp "of" sp primary)? | ident
period ::= "week" | "month" | "year"
periods ::= "days" | "weeks" | "months"
sp ::= " "
ident ::= [a-z] [a-z0-9_]*
word ::= [A-Za-z] [A-Za-z0-9_]*
cword ::= [A-Z] [A-Za-z0-9_]*
number ::= [0-9]+ ("." [0-9]+)?
snum ::= "-"? number
string ::= "\"" ( [^"\\\x00-\x1F] | "\\" ["\\n] )* "\""
time ::= [0-9] [0-9]? ":" [0-5] [0-9]
datelit ::= [0-9] [0-9] [0-9] [0-9] "-" [0-1] [0-9] "-" [0-3] [0-9]
dur ::= [0-9]+ ("s" | "m" | "h" | "d")
