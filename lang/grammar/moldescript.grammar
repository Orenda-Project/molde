# MoldeScript v0: the one grammar source.
#
# Syntax is llama.cpp GBNF. A rule may continue on following lines that start with spaces.
# This file describes ONE LINE (a statement) in canonical spacing. gen-gbnf.mjs adds:
#   root, newlines, and the indentation structure: a block-stmt may own child lines indented
#   by two more spaces (depth limit 8); a leaf-stmt owns none.
# parse.mjs interprets this same file, so the parser and the GBNF cannot drift.
# The terminals ident, word, number, string, time and dur are matched by the parser with the
# same character sets plus two extra rules the GBNF cannot state: an ident is never a keyword,
# and a keyword or number never runs straight into a letter.

# ---------- statements ----------
first-stmt ::= app-stmt | ask-stmt
lib-first ::= "lib" sp string

block-stmt ::= def-stmt | screen-stmt | each-stmt | if-stmt | else-stmt | box-stmt | draw-stmt | plot-stmt | poly-stmt | call-stmt
leaf-stmt ::= table-stmt | setting-stmt | state-stmt | let-stmt | remind-stmt | every-stmt | when-stmt | text-stmt | itext-stmt | icon-stmt
  | image-stmt | space-stmt | divider-stmt | field-stmt | toggle-stmt | choice-stmt | slider-stmt | button-stmt
  | shape-stmt | pt-stmt | tick-stmt | slot-stmt

# the app line: name, icon, colour (a theme or an accent colour), and dark or light to override the phone
app-stmt ::= "app" sp string (sp ident)? (sp theme)? (sp mode)?
ask-stmt ::= "ask" sp string (sp string)+
theme ::= "ocean" | "mint" | "slate" | "ink" | "plum"
  | "red" | "orange" | "yellow" | "green" | "teal" | "blue" | "purple" | "pink" | "grey"
mode ::= "dark" | "light"

# ---------- data ----------
table-stmt ::= "table" sp ident (sp "was" sp ident)? (sp string)? (sp field ("," sp field)*)?
setting-stmt ::= "setting" sp field (sp "set")?
state-stmt ::= "state" sp ident sp state-type (sp "was" sp ident)? (sp "=" sp (expr | word))? (sp "keep")? (sp "was" sp ident)?
state-type ::= type | "new" sp ident
let-stmt ::= "let" sp (ident | ident "(" param ("," sp param)* ")") sp "=" sp expr
field ::= ident sp type "?"? (sp fmod)*
type ::= "text" | "long" | "num" | "money" | "bool" | "date" | "time" | "when" | "dur" | "image"
  | "pick" sp option ("|" option)+ | "ref" sp ident
option ::= (word | string) (sp "was" sp word)?
fmod ::= range-lit | "=" sp lit | string | "unit" sp string | "was" sp ident
range-lit ::= snum ".." snum?
lit ::= "yes" | "no" | "today" | "now" | datelit | snum | string | time | dur | word

# ---------- components and screens ----------
def-stmt ::= "def" sp ident (sp param ("," sp param)*)?
param ::= ident sp (pkind | ident) (sp "=" sp arg)?
pkind ::= "num" | "money" | "text" | "bool" | "date" | "time" | "dur" | "color" | "icon" | "table" | "name" | "src" | "win" | "act"
call-stmt ::= ident (sp arg ("," sp later-arg)*)?
# a text value may be several parts side by side: statcard ml, "ml of" goal "today", goal
arg ::= actions | source | window | expr | string (sp tpart)+
# after a comma a text value may also start with a formula: section "Today", count(t today) "in all"
later-arg ::= arg | expr (sp tpart)+
slot-stmt ::= "slot"
screen-stmt ::= "screen" sp ident sp string (sp ident)?

# ---------- events ----------
remind-stmt ::= "remind" sp string sp remind-when (sp "if" sp expr)?
remind-when ::= "at" sp (time ("," sp time)* | path (sp add-op sp dur)? (sp "at" sp time)?) (sp "on" sp dayname (sp dayname)*)?
  | "every" sp dur (sp "from" sp time sp "to" sp time)?
  | "monthly" sp "on" sp number ("," sp number)* sp "at" sp time ("," sp time)*
dayname ::= "mon" | "tue" | "wed" | "thu" | "fri" | "sat" | "sun"
every-stmt ::= "every" sp dur (sp "if" sp expr)? sp actions
when-stmt ::= "when" sp expr sp actions

# ---------- structure ----------
# empty: the text shown when there is nothing (a quoted text, or a text value such as a component's parameter)
each-stmt ::= "each" sp source (sp "as" sp ident)? (sp "empty" sp (string | path))?
source ::= "days" sp window | "options" sp path | list | range | query
range ::= sum-expr ".." sum-expr
list ::= "[" lit ("," sp lit)* "]"
query ::= path (sp window)? (sp "where" sp expr)? (sp "by" sp group)? (sp ("sort" sp expr (sp "desc")? | "shuffle"))? (sp "top" sp number)?
group ::= "day" | "week" | "month" | path
if-stmt ::= "if" sp expr
else-stmt ::= "else"
box-stmt ::= ("stack" | "row" | "box" | "scroll" | "grid" sp number) (sp mod)*

# ---------- content and inputs ----------
text-stmt ::= "text" sp tparts (sp mod)*
# a line that starts with a quoted text, a number, a function, a bracket or a name is a text line
# (a name that is a component starts a component call instead: parse.mjs decides, it knows the components)
itext-stmt ::= (string | lead-expr) (sp tpart)* (sp mod)*
lead-expr ::= lead-prod (sp add-op sp prod-expr)*
lead-prod ::= lead-unary (sp mul-op sp unary)*
lead-unary ::= "-" unary | number | func | "(" expr ")" | ("it" | ident) ("." ident)+ | "it" | lead-ident
# a name that is not a statement word (gen-gbnf.mjs writes this rule out letter by letter for the GBNF)
lead-ident ::= ident
tparts ::= tpart (sp tpart)*
tpart ::= string | expr
icon-stmt ::= "icon" sp primary (sp mod)*
image-stmt ::= "image" sp expr (sp mod)*
space-stmt ::= "space" (sp number)?
divider-stmt ::= "divider"
button-stmt ::= "button" sp tparts (sp mod)*
field-stmt ::= "field" sp path (sp string)? (sp mod)*
toggle-stmt ::= "toggle" sp path (sp window)? (sp "where" sp expr)? (sp mod)*
choice-stmt ::= "choice" sp path (sp mod)*
slider-stmt ::= "slider" sp path sp range-lit (sp mod)*

# ---------- drawing (inside draw) ----------
draw-stmt ::= "draw" (sp number "," sp number)? (sp mod)*
# a chart frame: data coordinates (y grows upward), with optional axes and grid lines from the ranges
plot-stmt ::= "plot" sp range "," sp range (sp mod)*
# tick labels a value on the x axis of a plot; ytick on the y axis
tick-stmt ::= ("tick" | "ytick") sp expr "," sp tparts
shape-stmt ::= ("rect" sp e4 | "line" sp e4 | "circle" sp (e3 | expr) | "arc" sp (e5 | e3) | "path" sp string
  | "label" sp expr "," sp expr "," sp tparts) (sp mod)*
poly-stmt ::= "poly" (sp mod)*
pt-stmt ::= "pt" sp expr "," sp expr
e3 ::= expr "," sp expr "," sp expr
e4 ::= e3 "," sp expr
e5 ::= e4 "," sp expr

# ---------- style and events on elements ----------
mod ::= "big" | "head" | "faint" | "axes" | "gridlines" | "middle" | "full" | "ratio" sp expr | size | "bold" | "card" | "grow" | "color" sp expr | "fill" sp expr | "stroke" sp expr
  | "thick" sp expr | "opacity" sp expr | "width" sp expr | "height" sp expr | "radius" sp expr
  | "pad" sp number | "gap" sp number | "span" sp number | "align" sp align
  | "alt" sp string | "bar"
  | "tap" sp actions | "swipe" sp actions
size ::= "tiny" | "small" | "large" | "huge"
align ::= "start" | "center" | "end"

# ---------- actions ----------
actions ::= action (sp "then" sp action)*
action ::= "add" sp ident (sp assign ("," sp assign)*)? | "set" sp path sp "=" sp expr | "remove" sp expr
  | "set" sp "all" sp path sp "=" sp expr (sp "where" sp expr)? | "remove" sp "all" sp query
  | "toggle" sp path (sp window)? (sp "where" sp expr)?
  | "edit" sp expr | "save" sp ident | "go" sp ident | "notify" sp tparts | "remind" sp string sp "in" sp expr | "after" sp dur sp action | ident
assign ::= ident sp "=" sp expr

# ---------- formulas ----------
expr ::= and-expr (sp "or" sp and-expr)*
and-expr ::= not-expr (sp "and" sp not-expr)*
not-expr ::= "not" sp not-expr | cmp-expr
cmp-expr ::= sum-expr (sp cmp-op sp sum-expr)?
cmp-op ::= "=" | "!=" | "<=" | ">=" | "<" | ">"
sum-expr ::= prod-expr (sp add-op sp prod-expr)*
add-op ::= "+" | "-"
prod-expr ::= unary (sp mul-op sp unary)*
mul-op ::= "*" | "/" | "%"
unary ::= "-" unary | primary
primary ::= "yes" | "no" | "today" | "now" | "index" | "pi" | color | func ("." ident)* | "(" expr ")" | datelit | number | string | time | dur | path | cword
color ::= "accent" | "ink" | "muted" | "soft" | "good" | "warn" | "bad" | "bg" | "surface" | "edge"
  | "red" | "orange" | "yellow" | "green" | "teal" | "blue" | "purple" | "pink" | "grey" | "black" | "white"
path ::= ("it" | ident) ("." ident)*
func ::= agg query ")" | fold source "," sp expr ")" | "if(" expr "," sp expr "," sp expr ")"
  | "clamp(" expr "," sp expr "," sp expr ")" | fn1 expr ")" | fn2 expr "," sp expr ")" | ("min(" | "max(") expr "," sp expr ")"
  | "due(" query "," sp expr ")" | "nth(" query "," sp expr ")" | "random(" query ")" | "join(" tpart ("," sp tpart)* ")"
  | ident "(" expr ("," sp expr)* ")"
agg ::= "count(" | "sum(" | "avg(" | "min(" | "max(" | "last(" | "first(" | "streak(" | "best(" | "since(" | "gap("
# count(src, condition), sum(src, value), min(src, value), max(src, value): a formula for each item of the source
fold ::= "count(" | "sum(" | "min(" | "max("
fn1 ::= "round(" | "floor(" | "abs(" | "len(" | "weekday(" | "monthday(" | "monthdays(" | "dayname(" | "monthname(" | "hour("
  | "minute(" | "second(" | "month(" | "year(" | "sin(" | "cos(" | "hue(" | "random(" | "words("
fn2 ::= "has(" | "addmonths(" | "pow(" | "plural(" | "fixed("
window ::= "today" | "yesterday" | "all" | "prev" sp period | "last" sp number sp periods
  | "on" sp primary | period (sp "of" sp primary)? | ident
period ::= "week" | "month" | "year"
periods ::= "days" | "weeks" | "months"

# ---------- terminals ----------
sp ::= " "
ident ::= [a-z] [a-z0-9_]*
word ::= [A-Za-z] [A-Za-z0-9_]*
cword ::= [A-Z] [A-Za-z0-9_]*
number ::= [0-9]+ ("." [0-9]+)?
snum ::= "-"? number
string ::= "\"" ( [^"\\\x00-\x1F] | "\\" ["\\n] )* "\""
time ::= [0-9] [0-9]? ":" [0-5] [0-9]
# a date: 2026-11-30 (year, month, day)
datelit ::= [0-9] [0-9] [0-9] [0-9] "-" [0-1] [0-9] "-" [0-3] [0-9]
dur ::= [0-9]+ ("s" | "m" | "h" | "d")
